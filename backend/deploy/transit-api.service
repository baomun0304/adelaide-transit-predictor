[Unit]
Description=Adelaide Transit Predictor API
After=network.target

[Service]
Type=simple
User=opc
WorkingDirectory=/home/opc/adelaide-transit-predictor/backend
ExecStart=/home/opc/adelaide-transit-predictor/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
